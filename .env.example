# Copy this file to .env and fill in your values.
# The bot runs in MOCK mode (prints to console) when these are empty.

# Invent any long random string. Must match the Verify Token in Meta > Webhook.
VERIFY_TOKEN=change_me_to_something_long_and_random

# From developers.facebook.com > your app > WhatsApp > API Setup.
# Short-lived test token (starts with EAAG...), expires in ~24h.
WHATSAPP_TOKEN=YOUR_TOKEN_FROM_META

# Numeric ID of the Meta test phone number.
PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID

API_VERSION=v22.0
PORT=8000
